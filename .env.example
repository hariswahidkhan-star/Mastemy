# Copy to .env and fill in. Never commit .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
Jwt__Key=                       # >= 32 random characters
Database__MigrateOnStartup=true
Seed__SuperAdminEmail=
Seed__SuperAdminPassword=
Cors__Origins__0=https://your-domain.example
# Payments (checkout returns 503 payments_not_configured until set)
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__SuccessUrl=https://your-domain.example/me?checkout=success
Stripe__CancelUrl=https://your-domain.example/me?checkout=cancel
# YouTube (link authoring works without these; API metadata validation, playlist import and OAuth need them)
YouTube__ApiKey=
YouTube__OAuthClientId=
YouTube__OAuthClientSecret=
YouTube__OAuthRedirectUri=https://your-domain.example/api/youtube/oauth/callback
Commission__InstructorSharePercent=70
# Public site origin used for canonical URLs, sitemap and SSR
PUBLIC_BASE_URL=https://your-domain.example
# Host name of PUBLIC_BASE_URL (no scheme/port); the API only answers requests for this host (plus internal names)
PUBLIC_HOST=your-domain.example
Certificates__VerifyBaseUrl=https://your-domain.example/verify
# CIDR of the reverse proxy (compose network by default) whose X-Forwarded-* headers the API trusts
NETWORK_TRUSTED_PROXY_CIDR=172.16.0.0/12
